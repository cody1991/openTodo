# Server
PORT=3000
NODE_ENV=development

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d

# Database
DB_PATH=./data/todo.db

# GitHub Image Storage
GITHUB_TOKEN=ghp_your_github_personal_access_token
GITHUB_OWNER=your_github_username
GITHUB_REPO=your_image_repo_name
IMAGE_BASE_URL=https://raw.githubusercontent.com/your_username/your_repo/main

# WeChat Work (企业微信) Robot Webhook
WECOM_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=your_key
# Allowed Webhook hostnames (comma-separated), defaults to qyapi.weixin.qq.com
# WECOM_ALLOWED_HOSTS=qyapi.weixin.qq.com,your.internal.webhook.host

# Admin Account (used for initial seed)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_admin_password
